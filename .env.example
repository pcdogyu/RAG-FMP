# Required secrets. Never commit the populated .env file.
FMP_API_KEY=
MCP_BEARER_TOKEN=replace-with-a-long-random-token
WEKNORA_BASE_URL=http://weknora-app:8080
WEKNORA_API_KEY=
WEKNORA_KNOWLEDGE_BASE_ID=

# Deployment and request controls
DATABASE_URL=postgresql+psycopg://fmp_bridge:fmp_bridge@postgres:5432/fmp_bridge
REDIS_URL=redis://redis:6379/0
HOST=0.0.0.0
PORT=8000
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_REQUESTS_PER_MINUTE=240
FMP_DAILY_REQUEST_BUDGET=100000
FMP_CONCURRENCY=8
SYNC_SHARD_SIZE=250
# Keep FMP data on the live MCP path. Set true only when intentionally indexing data into WeKnora.
SYNC_ENABLED=false
SYNC_HOURLY_MINUTE=10
SYNC_CATALOG_HOUR=2
SYNC_BOOTSTRAP_LIMIT=0
# Optional comma-separated manual additions. These are unioned with SYNC_UNIVERSES.
SYNC_SYMBOLS=
# Dynamic market scopes: crypto, nasdaq, forex_g10. Leave blank to use only
# SYNC_SYMBOLS or SYNC_BOOTSTRAP_LIMIT.
SYNC_UNIVERSES=crypto,nasdaq,forex_g10
# Number of effective-universe symbols handled by each hourly rotation.
SYNC_ROTATION_BATCH_SIZE=1000
